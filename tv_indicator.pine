//----------helpers----------//
f_rel(stockR, benchR) =>
    na(stockR) or na(benchR) ? float(na) : ((1 + stockR / 100) / (1 + benchR / 100) - 1) * 100

f_fmtV(v, suffix) =>
    na(v) ? '-' : (v >= 0 ? '+' : '') + str.tostring(v, '0.00') + suffix

f_cellBg(v) =>
    na(v) ? color.new(color.gray, 80) : v >= 0 ? color.new(color.green, 70) : color.new(color.red, 70)

f_zCalc(x, len, isNewBar, samples) =>
    if isNewBar and not na(x)
        array.push(samples, x)
        if array.size(samples) > len
            array.shift(samples)
    m = array.size(samples) >= len ? array.avg(samples) : float(na)
    sd = array.size(samples) >= len ? array.stdev(samples) : float(na)
    na(sd) or sd == 0 ? float(na) : (x - m) / sd

f_calcSma(x, len, isNewBar, samples) =>
    if isNewBar and not na(x)
        array.push(samples, x)
        if array.size(samples) > len
            array.shift(samples)
    array.size(samples) >= len ? array.avg(samples) : float(na)

// Sector codes: CM Communications, CD Consumer Discretionary, CS Consumer Staples,
// EN Energy, FN Financials, HC Healthcare, IN Industrials, MT Materials,
// RE Real Estate, IT Technology, UT Utilities.
f_sectorInfo(name) =>
    string code = 'IN'
    int base = 700

    if str.startswith(name, 'Communications - ')
        code := 'CM'
        base := 100
    else if str.startswith(name, 'Technology - ')
        code := 'IT'
        base := 1000
    else if str.startswith(name, 'Industrials - ')
        code := 'IN'
        base := 700
    else if str.startswith(name, 'Financials - ')
        code := 'FN'
        base := 500
    else if str.startswith(name, 'Consumer Discretionary - ')
        code := 'CD'
        base := 200
    else if str.startswith(name, 'Consumer Staples - ')
        code := 'CS'
        base := 300
    else if str.startswith(name, 'Healthcare - ')
        code := 'HC'
        base := 600
    else if str.startswith(name, 'Utilities - ')
        code := 'UT'
        base := 1100
    else if str.startswith(name, 'Energy - ')
        code := 'EN'
        base := 400
    else if str.startswith(name, 'Materials - ')
        code := 'MT'
        base := 800
    else if str.startswith(name, 'Real Estate - ')
        code := 'RE'
        base := 900

    [code, base]

f_metricWithZ(value, zValue) =>
    f_fmtV(value, '%') + ' (' + f_fmtV(zValue, 'σ') + ')'

//----------find current group----------//
var string[] grpSyms = array.new_string()
var string grpName = ''
var bool grpFound = false
var int grpId = na
var string grpIdText = ''

if barstate.isfirst
    tk = str.upper(syminfo.ticker)

    for [i, grp] in indArr
        if not grpFound and array.includes(grp.symbols, tk)
            [sectorCode, sectorBase] = f_sectorInfo(grp.name)
            int sectorLocalId = 0

            for j = 0 to i
                priorGrp = array.get(indArr, j)
                [priorCode, priorBase] = f_sectorInfo(priorGrp.name)

                if priorCode == sectorCode
                    sectorLocalId += 1

            grpSyms := grp.symbols
            grpName := grp.name
            grpId := sectorBase + sectorLocalId
            grpIdText := sectorCode + str.tostring(sectorLocalId)
            grpFound := true

//----------benchmark data----------//
calcIsHigher = timeframe.in_seconds(calcTf) > timeframe.in_seconds()
reqOffset = confirmed and calcIsHigher ? 1 : 0
reqLookahead = confirmed and calcIsHigher ? barmerge.lookahead_on : barmerge.lookahead_off
newCalcBar = timeframe.change(calcTf)

[bR1, bR5, bR21, bR63, bR126, bAtrPct] = request.security(
     bench,
     calcTf,
     [
         ta.roc(close, 1)[reqOffset],
         ta.roc(close, 5)[reqOffset],
         ta.roc(close, 21)[reqOffset],
         ta.roc(close, 63)[reqOffset],
         ta.roc(close, 126)[reqOffset],
         (ta.atr(atrLen) / close * 100)[reqOffset]
     ],
     lookahead = reqLookahead)

//----------equal-weight group returns----------//
float s1 = 0.0
float s5 = 0.0
float s21 = 0.0
float s63 = 0.0
float s126 = 0.0

int n1 = 0
int n5 = 0
int n21 = 0
int n63 = 0
int n126 = 0

if grpFound
    for symbol in grpSyms
        [r1, r5, r21, r63, r126] = request.security(
             symbol,
             calcTf,
             [
                 ta.roc(close, 1)[reqOffset],
                 ta.roc(close, 5)[reqOffset],
                 ta.roc(close, 21)[reqOffset],
                 ta.roc(close, 63)[reqOffset],
                 ta.roc(close, 126)[reqOffset]
             ],
             lookahead = reqLookahead,
             ignore_invalid_symbol = true)

        if not na(r1)
            s1 += r1
            n1 += 1

        if not na(r5)
            s5 += r5
            n5 += 1

        if not na(r21)
            s21 += r21
            n21 += 1

        if not na(r63)
            s63 += r63
            n63 += 1

        if not na(r126)
            s126 += r126
            n126 += 1

absD = n1 > 0 ? s1 / n1 : float(na)
absW = n5 > 0 ? s5 / n5 : float(na)
absM = n21 > 0 ? s21 / n21 : float(na)
absQ = n63 > 0 ? s63 / n63 : float(na)
absH = n126 > 0 ? s126 / n126 : float(na)

//----------equal-weight relative index----------//
var float ewIndex = na

if grpFound
    if newCalcBar and not na(absD) and not na(bR1)
        ewIndex := nz(ewIndex[1], 100.0) * (1 + (absD - bR1) / 100)
    else
        ewIndex := nz(ewIndex[1], ewIndex)

var float[] ma1History = array.new_float()
var float[] ma2History = array.new_float()

ewMa1 = f_calcSma(ewIndex, ma1Len, newCalcBar, ma1History)
ewMa2 = f_calcSma(ewIndex, ma2Len, newCalcBar, ma2History)

plot(ewIndex, 'EW Group vs Benchmark (Rebalanced)', color = color.new(#2962FF, 0), linewidth = 2)
plot(ewMa1, '21 MA', color = color.orange, linewidth = 1)
plot(ewMa2, '50 MA', color = color.fuchsia, linewidth = 1)
hline(100, 'Anchor', color = color.new(color.gray, 50), linestyle = hline.style_dotted)

//----------relative-performance metrics----------//
rsD = f_rel(absD, bR1)
rsW = f_rel(absW, bR5)
rsM = f_rel(absM, bR21)
rsQ = f_rel(absQ, bR63)
rsH = f_rel(absH, bR126)

vaD = na(bAtrPct) or bAtrPct == 0 ? float(na) : (absD - bR1) / bAtrPct
vaW = na(bAtrPct) or bAtrPct == 0 ? float(na) : (absW - bR5) / bAtrPct
vaM = na(bAtrPct) or bAtrPct == 0 ? float(na) : (absM - bR21) / bAtrPct
vaQ = na(bAtrPct) or bAtrPct == 0 ? float(na) : (absQ - bR63) / bAtrPct
vaH = na(bAtrPct) or bAtrPct == 0 ? float(na) : (absH - bR126) / bAtrPct

selD = metricSel == 'Absolute %' ? absD : metricSel == 'RS vs SPY' ? rsD : vaD
selW = metricSel == 'Absolute %' ? absW : metricSel == 'RS vs SPY' ? rsW : vaW
selM = metricSel == 'Absolute %' ? absM : metricSel == 'RS vs SPY' ? rsM : vaM
selQ = metricSel == 'Absolute %' ? absQ : metricSel == 'RS vs SPY' ? rsQ : vaQ
selH = metricSel == 'Absolute %' ? absH : metricSel == 'RS vs SPY' ? rsH : vaH

//----------z-scores----------//
var float[] zDHistory = array.new_float()
var float[] zWHistory = array.new_float()
var float[] zMHistory = array.new_float()
var float[] zQHistory = array.new_float()
var float[] zHHistory = array.new_float()

zD = f_zCalc(selD, zLen, newCalcBar, zDHistory)
zW = f_zCalc(selW, zLen, newCalcBar, zWHistory)
zM = f_zCalc(selM, zLen, newCalcBar, zMHistory)
zQ = f_zCalc(selQ, zLen, newCalcBar, zQHistory)
zH = f_zCalc(selH, zLen, newCalcBar, zHHistory)

//----------0-100 group score----------//
rankRelPerf = na(rsM) or na(rsQ) ? float(na) : (rsM + rsQ) / 2.0
groupScore = na(rankRelPerf) ? float(na) : 100.0 / (1.0 + math.exp(-0.15 * rankRelPerf))

//----------Data Window / screener outputs----------//
plot(groupScore, 'Screener: Group Score 0-100', display = display.data_window)
plot(grpId, 'Screener: Sector Group Numeric ID', display = display.data_window)
plot(n21, 'Screener: Group Member Count', display = display.data_window)
plot(groupScore >= topScore ? 1 : 0, 'Screener: Top Group Pass', display = display.data_window)

// Selected performance values match the table's RS Type setting.
// These outputs appear in the Data Window without changing the chart scale.
plot(selD, 'Table: 1D Performance', display = display.data_window)
plot(selW, 'Table: 1W Performance', display = display.data_window)
plot(selM, 'Table: 1M Performance', display = display.data_window)
plot(selQ, 'Table: 3M Performance', display = display.data_window)
plot(selH, 'Table: 6M Performance', display = display.data_window)

plot(zD, 'Table: 1D Z-Score', display = display.data_window)
plot(zW, 'Table: 1W Z-Score', display = display.data_window)
plot(zM, 'Table: 1M Z-Score', display = display.data_window)
plot(zQ, 'Table: 3M Z-Score', display = display.data_window)
plot(zH, 'Table: 6M Z-Score', display = display.data_window)

// Relative performance outputs always use the benchmark comparison.
plot(rsD, 'Screener: Group 1D Rel Perf', display = display.data_window)
plot(rsW, 'Screener: Group 5D Rel Perf', display = display.data_window)
plot(rsM, 'Screener: Group 21D Rel Perf', display = display.data_window)
plot(rsQ, 'Screener: Group 63D Rel Perf', display = display.data_window)
plot(rsH, 'Screener: Group 126D Rel Perf', display = display.data_window)

alertcondition(
     groupScore >= topScore,
     'Top Group Score',
     'This ticker belongs to a group at or above the selected score threshold.')

//----------shortened group label----------//
f_short(name) =>
    parts = str.split(name, ' - ')
    core = array.size(parts) > 1 ? array.get(parts, 1) : name
    str.length(core) > 22 ? str.substring(core, 0, 22) + '…' : core

//----------compact two-row table----------//
tblPosition = tablePos == 'Top Left' ? position.top_left :
     tablePos == 'Bottom Right' ? position.bottom_right :
     tablePos == 'Bottom Left' ? position.bottom_left :
     position.top_right

var table perf = table.new(tblPosition, 9, 2, border_width = 1)

txtCol = theme == 'Dark' ? color.white : color.black
hdrBg = theme == 'Dark' ? color.new(#131722, 0) : color.new(#F0F3FA, 0)

if barstate.islast
    table.clear(perf, 0, 0, 8, 1)

    if showTable and grpFound
        metricLabel = metricSel == 'Absolute %' ? 'Abs %' :
             metricSel == 'RS vs SPY' ? 'RS %' :
             'Vol RS'

        table.cell(perf, 0, 0, fullName ? grpName : f_short(grpName), text_color = txtCol, bgcolor = hdrBg, text_halign = text.align_left)
        table.cell(perf, 1, 0, showScore ? 'Score' : '', text_color = txtCol, bgcolor = hdrBg)
        table.cell(perf, 2, 0, showId ? 'ID' : '', text_color = txtCol, bgcolor = hdrBg)
        table.cell(perf, 3, 0, showDay ? '1D' : '', text_color = txtCol, bgcolor = hdrBg)
        table.cell(perf, 4, 0, showWeek ? '1W' : '', text_color = txtCol, bgcolor = hdrBg)
        table.cell(perf, 5, 0, showMonth ? '1 Mo' : '', text_color = txtCol, bgcolor = hdrBg)
        table.cell(perf, 6, 0, showQtr ? '3 Mo' : '', text_color = txtCol, bgcolor = hdrBg)
        table.cell(perf, 7, 0, showHalf ? '6M' : '', text_color = txtCol, bgcolor = hdrBg)
        table.cell(perf, 8, 0, showCount ? '#' : '', text_color = txtCol, bgcolor = hdrBg)

        table.cell(perf, 0, 1, metricLabel, text_color = txtCol, bgcolor = hdrBg, text_halign = text.align_left)
        table.cell(perf, 1, 1, showScore ? str.tostring(groupScore, '0.0') : '', text_color = txtCol, bgcolor = showScore ? f_cellBg(groupScore - 50) : hdrBg)
        table.cell(perf, 2, 1, showId ? grpIdText : '', text_color = txtCol, bgcolor = hdrBg)
        table.cell(perf, 3, 1, showDay ? f_metricWithZ(selD, zD) : '', text_color = txtCol, bgcolor = showDay ? f_cellBg(selD) : hdrBg)
        table.cell(perf, 4, 1, showWeek ? f_metricWithZ(selW, zW) : '', text_color = txtCol, bgcolor = showWeek ? f_cellBg(selW) : hdrBg)
        table.cell(perf, 5, 1, showMonth ? f_metricWithZ(selM, zM) : '', text_color = txtCol, bgcolor = showMonth ? f_cellBg(selM) : hdrBg)
        table.cell(perf, 6, 1, showQtr ? f_metricWithZ(selQ, zQ) : '', text_color = txtCol, bgcolor = showQtr ? f_cellBg(selQ) : hdrBg)
        table.cell(perf, 7, 1, showHalf ? f_metricWithZ(selH, zH) : '', text_color = txtCol, bgcolor = showHalf ? f_cellBg(selH) : hdrBg)
        table.cell(perf, 8, 1, showCount ? str.tostring(n21) : '', text_color = txtCol, bgcolor = hdrBg)

    else if showTable
        table.cell(perf, 0, 0, 'Ticker not in any group: ' + syminfo.ticker, text_color = txtCol, bgcolor = hdrBg)
