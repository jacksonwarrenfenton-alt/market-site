//@version=6
indicator('Industry Group Strength - EW vs SPY (Final Groups)', overlay = false, dynamic_requests = true)

// Classification revision: 2026-08-31; supplied universe originated 2026-08-29.
// 253 custom business-exposure baskets; 2,625 members, each ticker assigned once.
// Eligibility checked against the retrieved TradingView snapshot on 2026-08-31:
// market cap > $500M; latest close * 10D average share volume > $5M.
// This is a dollar-volume proxy, not exact average daily dollar turnover.
// Removed: SBGI (liquidity), CCXI (SPAC), PSUS (fund), LBTYK/BEP (duplicate exposure).
// Adds 49 qualifying depositary receipts from the supplied reference watchlists.
// Original-universe-only companion available; no claim to cover every eligible global stock.
// 4-30 members per basket. Sector order follows the supplied 11 watchlists.
// Custom sector labels are not official BICS/GICS. Cross-sector themes are deliberate.
// Sources and every assignment: final-group-rundown.md and reference-reconciliation.md.
// Added 1D, 1W and 6M table metrics using 1, 5 and 126 calculation bars.
// Period labels assume a 1D calculation timeframe; group score remains based on 1M and 3M.
// Reclassification changes historical basket returns and order-derived group IDs.
// This is a present-day membership view, not a point-in-time historical universe.
// Performance values and Z-scores are also exposed in the Data Window.

//----------settings----------//
bench     = input.symbol('SPY', 'Benchmark', display = display.none)
ma1Len    = input.int(21, 'Fast MA Length', minval = 1, display = display.none)
ma2Len    = input.int(50, 'Slow MA Length', minval = 1, display = display.none)
atrLen    = input.int(14, 'SPY ATR Length (Vol-Adj)', minval = 1, group = 'Metric')
metricSel = input.string('RS vs SPY', 'RS Type', options = ['Absolute %', 'RS vs SPY', 'Vol-Adj RS (SPY ATR14)'], group = 'Metric')
zLen      = input.int(100, 'Z-Score Lookback (calculation bars)', minval = 20, group = 'Metric')
calcTf    = input.string('1D', 'Calculation Timeframe', options = ['1', '5', '15', '30', '60', '120', '240', '1D', '1W', '1M'], group = 'Calculation')
confirmed = input.bool(true, 'Use Confirmed Higher-TF Data', tooltip = 'Recommended on intraday charts. Daily/weekly/monthly values update only after that calculation bar closes.', group = 'Calculation')
topScore  = input.float(90.0, 'Top-Group Score Threshold', minval = 0, maxval = 100, step = 1, group = 'Screener')
showTable = input.bool(true, 'Show Table', group = 'Table')
tablePos  = input.string('Top Right', 'Table Position', options = ['Top Right', 'Top Left', 'Bottom Right', 'Bottom Left'], group = 'Table')
fullName  = input.bool(false, 'Show Full Group Name', group = 'Table')
showScore = input.bool(true, 'Show Score', group = 'Table')
showId    = input.bool(true, 'Show Group ID', group = 'Table')
showDay   = input.bool(true, 'Show 1 Day', group = 'Table')
showWeek  = input.bool(true, 'Show 1 Week', group = 'Table')
showMonth = input.bool(true, 'Show Month', group = 'Table')
showQtr   = input.bool(true, 'Show 3 Month', group = 'Table')
showHalf  = input.bool(true, 'Show 6 Month', group = 'Table')
showCount = input.bool(true, 'Show Member Count', group = 'Table')
theme     = input.string('Dark', 'Color Mode', ['Dark', 'Light'], display = display.none)

if timeframe.in_seconds(calcTf) < timeframe.in_seconds()
    runtime.error('Calculation Timeframe must be equal to or higher than the chart timeframe')

//----------industry groups----------//
type industry
    string name
    string[] symbols

